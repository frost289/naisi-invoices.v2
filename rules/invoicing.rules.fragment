// ---- Orders ------------------------------------------------------------
// Lock:    Approved -> Invoicing  : needs an attempt token and a lease start equal to request.time
// Resume:  Invoicing -> Invoicing : only after the lease has expired (server time, not the browser's clock)
// Commit:  Invoicing -> Invoiced  : invoiceId must be 'ord_' + order id, and that invoice must exist after the commit
// Release: Invoicing -> Approved  : only clears the token/lease fields
//
// function lockFieldsOk() {
//   return request.resource.data.invoicingAttempt is string
//       && request.resource.data.invoicingLeaseStartedAt == request.time;
// }
// match /orders/{orderId} {
//   allow update: if isManager() && (
//        // ... your existing branches for other transitions ...
//        (resource.data.status == 'Approved'  && request.resource.data.status == 'Invoicing' && lockFieldsOk())
//     || (resource.data.status == 'Invoicing' && request.resource.data.status == 'Invoicing' && lockFieldsOk()
//           && request.time > resource.data.invoicingLeaseStartedAt + duration.value(10, 'm'))   // keep in step with INVOICING_LEASE_MS
//     || (resource.data.status == 'Invoicing' && request.resource.data.status == 'Invoiced'
//           && request.resource.data.invoiceId == 'ord_' + orderId
//           && existsAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId))
//           && !exists(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)))
//     || (resource.data.status == 'Invoicing' && request.resource.data.status == 'Approved'
//           && request.resource.data.invoicingAttempt == null)
//   );
// }
// Old clients write status 'Invoiced' with an automatic invoice id (not 'ord_<orderId>'), so the Commit branch refuses them.
//
// Note on get()/getAfter(): each counts as a document read toward the rules limit (10 per request,
// 20 per transaction/batch). The proposal above uses up to 2 per write.

// ---- Products ----------------------------------------------------------
// The new app writes `unitsPerCase` (a positive integer) on create only when it is set, and on edit only
// when the manager changed it; clearing the field writes null (updateProduct in src/products.js).
// If your rules use a field allowlist for products, add:
//   !('unitsPerCase' in request.resource.data) || request.resource.data.unitsPerCase == null
//     || (request.resource.data.unitsPerCase is int && request.resource.data.unitsPerCase > 0)
// and add 'unitsPerCase' to the allowed key list.
// Receiving stock now writes products (stockOnHand [+ unitsPerCase]) and stockMovements in ONE transaction;
// if your rules validate the movement against the product with getAfter(), that still holds.

