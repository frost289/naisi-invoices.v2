// dropped in as-is. Whoever owns the real rules should merge these conditions
// into the existing match blocks, then run tests/rules/invoicing.rules.test.js
// against the merged file in the Firestore emulator.
//
// Purpose: make the BACKEND enforce "one invoice per order", so that browser
// tabs still running the previous version of the app cannot bypass it.
//
// Replace isManagerOrSubmitter() etc. with whatever helper your rules already use.
// =====================================================================

// ---- Invoices ----------------------------------------------------------
// New-version clients ALWAYS write an `orderId` field (null for stand-alone invoices).
// The previous version never wrote that field, so requiring its presence blocks the
// old "addDoc with an automatic id" path.
function invoiceIsNewShape() {
  return request.resource.data.keys().hasAll(['orderId', 'invoiceNo', 'items', 'createdBy'])
      && request.resource.data.createdBy == request.auth.uid;
}
function orderInvoiceIdOk(db) {
  // invoice for an order: deterministic id, and the order must be marked Invoiced to THIS invoice in the same commit
  let orderPath = /databases/$(db)/documents/orders/$(request.resource.data.orderId);
  return request.resource.id == 'ord_' + request.resource.data.orderId
      && getAfter(orderPath).data.status == 'Invoiced'
      && getAfter(orderPath).data.invoiceId == request.resource.id
      && getAfter(orderPath).data.invoiceNo == request.resource.data.invoiceNo
      && get(orderPath).data.status == 'Invoicing';
}
// match /invoices/{id} {
//   allow create: if isManager() && invoiceIsNewShape()
//                 && (request.resource.data.orderId == null || orderInvoiceIdOk(db));
//   // `create` on an id that exists is already refused (that is an update), so ord_<id> cannot be created twice.
// }

