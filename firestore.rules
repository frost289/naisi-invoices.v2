rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null &&
        request.auth.token.email in
        get(/databases/$(database)/documents/config/roles).data.managers;
    }

    function isSubmitter() {
      return request.auth != null &&
        request.auth.token.email in
        get(/databases/$(database)/documents/config/roles).data.submitters;
    }

    match /config/roles {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Invoice numbering counter. Only managers ever generate invoices
    // (see main.js — loadCounterState/incrementCounterAtomically/
    // setCounterStart are all inside `if (isManager)` blocks), so this
    // is manager-only end to end. Do not widen this without also
    // widening who can write to /invoices.
    match /counters/{counterId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if false;
    }

    // Order numbering counter. Submitters legitimately need this —
    // it's reserved every time a rep submits an order.
    match /orderCounters/{counterId} {
      allow read: if isManager() || isSubmitter();
      allow create: if isManager() || isSubmitter();
      allow update: if (isManager() || isSubmitter()) &&
        request.resource.data.counter == resource.data.counter + 1;
      allow delete: if false;
    }

    // Invoices are only ever created by a manager, generated from an
    // approved order (Priority 2 flow). Submitters get their invoice
    // number via orders/{orderId}.invoiceNo instead — they never need
    // direct access to this collection.
    match /invoices/{invoiceId} {
      allow create: if isManager();
      allow read: if isManager();
      allow update: if isManager();
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isManager() || isSubmitter();
      allow create: if isManager() || isSubmitter();
      allow update: if isManager() || isSubmitter();
      allow delete: if isManager();
    }

    match /expenses/{expenseId} {
      allow create: if isManager() || isSubmitter();
      allow read: if isManager() ||
        (isSubmitter() && resource.data.createdBy == request.auth.uid);
      allow update: if isManager() ||
        (isSubmitter() && resource.data.createdBy == request.auth.uid);
      allow delete: if isManager();
    }

    // Products carry stockOnHand now. Reps still only need read access
    // (to see live stock in the quick-add grid); only managers can
    // change the catalog or stock levels — always via a transaction
    // in stock.js, so every stockOnHand change is paired with a
    // stockMovements ledger entry.
    match /products/{productId} {
      allow read: if isManager() || isSubmitter();
      allow create, update, delete: if isManager();
    }

    // Append-only stock ledger. Never updated or deleted — every entry
    // is written atomically alongside its products/{id}.stockOnHand
    // change inside a transaction (see stock.js). Manager-only, since
    // stock changes only ever originate from manager actions (manual
    // adjustment, approving/cancelling/editing an order).
    match /stockMovements/{movementId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update: if false;
      allow delete: if false;
    }

    // Only managers can change an order's status now — reps can no
    // longer cancel their own orders. Reps just create (submit) them.
    match /orders/{orderId} {
      allow create: if isManager() || isSubmitter();
      allow read: if isManager() ||
        (isSubmitter() && resource.data.createdBy == request.auth.uid);
      allow update: if isManager();
      allow delete: if false;
    }

    // Visit reports: reps log their own, managers see everyone's
    // for the success-rate report. Managers can correct entries.
    match /visits/{visitId} {
      allow create: if isManager() || isSubmitter();
      allow read: if isManager() ||
        (isSubmitter() && resource.data.repId == request.auth.uid);
      allow update: if isManager();
      allow delete: if false;
    }
  }
}
